rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Datos personales de cada usuario
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Código de invitación -> id del hogar (se puede leer uno concreto, no listar)
    match /codes/{code} {
      allow get: if request.auth != null;
      allow create: if request.auth != null;
    }

    // Hogar compartido: solo sus miembros leen y escriben.
    // Un usuario nuevo solo puede añadirse a sí mismo.
    match /households/{hid} {
      allow read: if request.auth != null && request.auth.uid in resource.data.memberIds;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.memberIds;
      allow update: if request.auth != null && (
        request.auth.uid in resource.data.memberIds ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'members'])
          && request.auth.uid in request.resource.data.memberIds
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1));
    }
  }
}
